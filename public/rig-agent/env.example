# GYDS rig program settings — copy to .env next to agent.mjs and keep it private.
# The dashboard's "Add rig" screen gives you the exact DASHBOARD_URL and RIG_TOKEN.

# Your published dashboard address (not the private preview address)
DASHBOARD_URL=https://your-dashboard.example.com
# Token shown once when you add the rig (rig_ followed by 64 characters)
RIG_TOKEN=rig_replace_me
# Name shown on the dashboard (defaults to the machine's hostname)
RIG_NAME=my-rig

# Paths to mining programs you've installed — only needed for non-GYDS coins.
# GYDS uses the built-in miner and needs nothing extra.
XMRIG_PATH=xmrig
TREX_PATH=t-rex
LOLMINER_PATH=lolMiner
SRBMINER_PATH=SRBMiner-MULTI
CGMINER_PATH=cgminer

# Let the dashboard change GPU power limit, clocks and fans on this machine.
# NVIDIA power limits need the program to run as root/admin (RUN_AS_ROOT=1 when installing on Linux).
ALLOW_GPU_OC=false

# Install new rig program versions automatically when the dashboard has one.
# false = the dashboard shows "Update available" and you press Update.
AUTO_UPDATE=false
