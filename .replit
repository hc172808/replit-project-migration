modules = ["bash", "web", "bun-1.3", "nodejs-22"]

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PATH=/nix/store/y3qbzvdfdp9jklxqks0lcr862xpgj4qi-nodejs-22.23.4-wrapped/bin:$PATH npm run dev"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-lc", "PATH=/nix/store/y3qbzvdfdp9jklxqks0lcr862xpgj4qi-nodejs-22.23.4-wrapped/bin:$PATH npm run start"]
build = ["bash", "-lc", "PATH=/nix/store/y3qbzvdfdp9jklxqks0lcr862xpgj4qi-nodejs-22.23.4-wrapped/bin:$PATH npm run deploy:check"]

