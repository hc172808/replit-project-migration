# GYDS Miner — example settings for self-hosting the dashboard.
# Copy to .env and fill in. Never commit real secrets.

# Backend (Lovable Cloud) connection used by the browser
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_SUPABASE_PROJECT_ID=your-project

# Same values for the server
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only admin key (rig check-ins use it). Keep private.
SUPABASE_SERVICE_ROLE_KEY=

# WalletConnect project ID from cloud.reown.com (public; enables phone wallet sign-in)
VITE_WALLETCONNECT_PROJECT_ID=

# ── Rig program ──────────────────────────────────────────────
# Each mining machine has its own .env next to agent.mjs.
# See public/rig-agent/env.example (served at /rig-agent/env.example).
